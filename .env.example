# Supabase Configuration
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Local-only demo listing scripts. NEVER prefix service role/password with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Single-owner fallback. Leave empty when DEMO_LANDLORD_EMAILS is set.
DEMO_LANDLORD_EMAIL=
# Comma-separated allowlist; must list every email in seed/landlords.json.
DEMO_LANDLORD_EMAILS=
DEMO_ACCOUNT_PASSWORD=
# Shared password of the landlords in seed/landlords.json (empty = DEMO_ACCOUNT_PASSWORD).
DEMO_LANDLORD_PASSWORD=
DEMO_MODERATOR_EMAIL=admin@tronhanh.demo
